#version 450
layout(local_size_x = 8) in;
layout(set = 0, binding = 0, std430) buffer Values { uint values[]; };
layout(set = 0, binding = 1, r32f) uniform writeonly image3D volume;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(values.length())) {
        values[i] = values[i] * 3u + 7u;
    }
    if (i < 8u) {
        ivec3 p = ivec3(int(i & 1u), int((i >> 1u) & 1u), int(i >> 2u));
        imageStore(volume, p, vec4(float(i) / 8.0, 0, 0, 1));
    }
}
