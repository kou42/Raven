#version 430 core

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Parameters
{
    ivec4 origin;
    uvec4 dimensions;
    vec4 kernelParams;
};
#ifndef RAVEN_SPH_CLEAR
layout(std430, binding = 1) readonly buffer Particles { vec4 particles[]; };
#endif
#ifdef RAVEN_SPH_DENSITY
layout(std430, binding = 2) readonly buffer Grid { int links[]; };
#else
layout(std430, binding = 2) buffer Grid { int links[]; };
#endif
layout(std430, binding = 3) buffer Result { uint result[]; };

uint CellCount()
{
    return dimensions.x * dimensions.y * dimensions.z;
}

#ifndef RAVEN_SPH_CLEAR
ivec3 Cell(vec3 position)
{
    return ivec3(floor(position * kernelParams.x)) - origin.xyz;
}

bool Inside(ivec3 cell)
{
    return all(greaterThanEqual(cell, ivec3(0))) && all(lessThan(cell, ivec3(dimensions.xyz)));
}

uint Index(ivec3 cell)
{
    return uint(cell.x) + dimensions.x * (uint(cell.y) + dimensions.y * uint(cell.z));
}
#endif

void main()
{
    uint particle = gl_GlobalInvocationID.x;
#ifdef RAVEN_SPH_CLEAR
    if (particle < CellCount())
    {
        links[particle] = -1;
    }
    if (particle == 0u)
    {
        result[0] = 0u;
    }
#else
    if (particle >= dimensions.w)
    {
        return;
    }
    vec3 position = particles[particle].xyz;
    ivec3 center = Cell(position);
#ifdef RAVEN_SPH_BUILD
    // セル内には粒子ごとのリンクを使い、局所的な密集でも固定バケット容量を超えません。
    if (Inside(center))
    {
        links[CellCount() + particle] = atomicExchange(links[Index(center)], int(particle));
    }
    else
    {
        atomicOr(result[0], 1u);
    }
#else
    float density = 0.0;
    // セル幅は2hなので、隣接する27セルの外にはh以内の粒子はありません。
    for (int z = -1; z <= 1; ++z)
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        ivec3 cell = center + ivec3(x, y, z);
        if (!Inside(cell))
        {
            continue;
        }
        for (int neighbor = links[Index(cell)]; neighbor >= 0; neighbor = links[CellCount() + uint(neighbor)])
        {
            vec4 sampleParticle = particles[neighbor];
            vec3 displacement = position - sampleParticle.xyz;
            float rSquared = dot(displacement, displacement);
            if (rSquared <= kernelParams.y)
            {
                float gap = kernelParams.y - rSquared;
                density += max(0.0, sampleParticle.w) * (kernelParams.z * gap * gap * gap);
            }
        }
    }
    if (isnan(density) || isinf(density))
    {
        atomicOr(result[0], 2u);
    }
    result[particle + 1u] = floatBitsToUint(density);
#endif
#endif
}
