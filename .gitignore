build/
bin/
out/

# Visual Studio
.vs/
.vscode/

# Configurations
Debug/
Release/
x64/
x86/

# Keep the physics debug renderer source tracked even though it lives under a Debug folder.
!/Root/Root/Raven/Physics/Debug/
!/Root/Root/Raven/Physics/Debug/PhysicsDebugRenderer.cpp

# Objects
*.obj
*.o
*.pch
*.pdb
*.ilk

# Executables
*.exe
*.out

# Libraries
*.lib
*.dll

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Logs
*.log

# Temp
*.tmp
*.temp

# 比較用SceneのソースだけをDebug/ビルド出力の規則から除外します。
!Root/Root/Raven/Scene/Debug/
Root/Root/Raven/Scene/Debug/*
!Root/Root/Raven/Scene/Debug/EditorBackendComparisonScene.h
!Root/Root/Raven/Scene/Debug/EditorBackendComparisonScene.cpp

# ローカル検証の生成物（CSV、ログ、終了コード、配置バックアップなど）。
# 再利用する検証スクリプトは scripts/、共有する検証結果は docs/ に保存する。
/artifacts/
/.codex-worktrees/

# 個人用のIDE設定と、自動保存される画面配置。
*.vcxproj.user
/Root.code-workspace
/Root/Root/imgui.ini
RavenEditorDock.layout.json
RavenEditorDock.layout.json.bak
RavenUIDockDemo.layout.json
RavenUIDockDemo.layout.json.bak

# UI計測の生CSVだけを除外し、共有データやテスト入力のCSVは管理できるようにする。
RavenUI-recording-*.csv

# ローカルのエラー出力とバックアップ。
*.err
*.bak
